{
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
        'local>nilsjr/renovate-config',
        'config:best-practices',
        ':semanticCommits',
        ':semanticCommitTypeAll(ci)',
        ':disableRateLimiting',
        ':automergeAll',
    ],
    // The g00fy2/alpaquita-android base image in the Dockerfile FROM line is tracked by
    // Renovate's built-in docker manager; see the packageRule below for its versioning.
    customManagers: [
        {
            customType: 'regex',
            managerFilePatterns: [
                '.github/workflows/*.yaml',
            ],
            matchStrings: [
                'DOCKER_BUILDX_VERSION:\\s*(?<currentValue>.*)',
            ],
            depNameTemplate: 'docker/buildx',
            datasourceTemplate: 'github-releases',
        },
        {
            customType: 'regex',
            managerFilePatterns: [
                '.github/workflows/*.yaml',
            ],
            matchStrings: [
                'DOCKER_BUILDKIT_VERSION:\\s*(?<currentValue>.*)',
            ],
            depNameTemplate: 'moby/buildkit',
            datasourceTemplate: 'github-releases',
        },
        {
            customType: 'regex',
            managerFilePatterns: [
                '.github/workflows/*.yaml',
            ],
            matchStrings: [
                'DIVE_VERSION:\\s*(?<currentValue>.*)',
            ],
            depNameTemplate: 'wagoodman/dive',
            datasourceTemplate: 'github-releases',
        },
        {
            customType: 'regex',
            managerFilePatterns: [
                '.github/workflows/*.yaml',
            ],
            matchStrings: [
                'ACTIONLINT_VERSION:\\s*(?<currentValue>.*)',
            ],
            depNameTemplate: 'rhysd/actionlint',
            datasourceTemplate: 'github-releases',
        },
        {
            customType: 'regex',
            managerFilePatterns: [
                '.github/workflows/*.yaml',
            ],
            matchStrings: [
                'YAMLLINT_VERSION:\\s*(?<currentValue>.*)',
            ],
            depNameTemplate: 'yamllint',
            datasourceTemplate: 'pypi',
        },
        {
            // Tracks the STABLE-channel emulator revision Google publishes — the same
            // channel `sdkmanager --channel=0` installs (see the emulator_version
            // custom datasource below). Mirrors setup-emulator.sh's own assert: if this
            // drifts from what actually gets installed, the build fails loudly
            // rather than shipping a silently-wrong image.
            customType: 'regex',
            managerFilePatterns: [
                '/versions\\.env$/',
            ],
            matchStrings: [
                'ANDROID_EMULATOR_VERSION=(?<currentValue>.*)',
            ],
            depNameTemplate: 'android_emulator_version',
            datasourceTemplate: 'custom.android_emulator_version',
        },
        {
            // mobile-dev-inc/maestro tags releases as "cli-<version>" (e.g. "cli-2.8.0");
            // extractVersionTemplate strips that prefix so it compares as plain semver.
            customType: 'regex',
            managerFilePatterns: [
                '/versions\\.env$/',
            ],
            matchStrings: [
                'MAESTRO_VERSION=(?<currentValue>.*)',
            ],
            depNameTemplate: 'mobile-dev-inc/maestro',
            datasourceTemplate: 'github-releases',
            extractVersionTemplate: '^cli-(?<version>.*)$',
        },
    ],
    customDatasources: {
        // Resolves the emulator revision (major.minor.micro) of the package tied to the
        // STABLE channel in Google's repository XML, mirroring the emulator-version-fetcher
        // action: resolve the stable channel id, then scan every
        // <remotePackage path="emulator"> ... </remotePackage> block and read the first
        // <major>/<minor>/<micro> inside it (later ones belong to <dependencies>).
        // Working per block instead of at fixed line offsets keeps the lookup stable when
        // Google adds, removes or reorders elements inside a package.
        android_emulator_version: {
            defaultRegistryUrlTemplate: 'https://dl.google.com/android/repository/repository2-3.xml',
            format: 'plain',
            transformTemplates: [
                "($lines := releases.version; $numbered := $lines#$i.{\"index\": $i, \"line\": $}; $stableChannelLine := $numbered[$contains(line, '>stable</channel>')][0].line; $stableChannelId := $stableChannelLine ? $replace($stableChannelLine, /.*<channel id=\"([^\"]+)\">.*/, \"$1\") : 'channel-0'; $packageEnds := [$numbered[$contains(line, '</remotePackage>')].index]; $revisionPart := function($block, $tag) { ($tagLine := $block[$contains($, '<' & $tag & '>')][0]; $tagLine ? $replace($tagLine, /.*>([0-9]+)<.*/, \"$1\") : '0') }; $stableVersions := [$numbered[$contains(line, 'remotePackage path=\"emulator\"')].index.($start := $; $end := $min($packageEnds[$ > $start]); $block := $numbered[index > $start and index < $end].line; $count($block[$contains($, '<channelRef ref=\"' & $stableChannelId & '\"/>')]) > 0 ? $revisionPart($block, 'major') & '.' & $revisionPart($block, 'minor') & '.' & $revisionPart($block, 'micro'))]; $count($stableVersions) > 0 ? {\"releases\": [{\"version\": $stableVersions[0]}]} : {\"releases\": []})",
            ],
        },
    },
    packageRules: [
        {
            // Tags look like "android-37.2-jdk26-v2026.10.5". Docker versioning rejects the
            // non-numeric "android-" prefix, and the release tags are immutable, so without
            // this rule Renovate never proposes a newer release. The platform/JDK part is
            // the compatibility key, so only the upstream release number moves.
            description: 'Track base image releases within the pinned platform/JDK line and use "fix"',
            matchPackageNames: [
                'g00fy2/alpaquita-android',
            ],
            versioning: 'regex:^android-(?<compatibility>.+)-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$',
            semanticCommitType: 'fix',
        },
        {
            description: 'Group official Docker Build Tool and Actions',
            matchPackageNames: [
                'docker/**',
                'moby/**',
            ],
            groupName: 'docker build tools and actions',
            separateMajorMinor: false,
            // Every Sunday (all day)
            schedule: [
                '* * * * 0',
            ],
        },
        {
            description: 'Group official GitHub Actions',
            matchPackageNames: [
                'actions/**',
            ],
            groupName: 'github core actions',
            separateMajorMinor: false,
            // Every Sunday (all day)
            schedule: [
                '* * * * 0',
            ]
        }
    ],
}
