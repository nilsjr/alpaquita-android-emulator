# Android emulator package version (stable channel) — asserted at image build time
ANDROID_EMULATOR_VERSION=37.1.11
# API levels to publish; first entry is the newest and receives the `latest` tag
EMULATOR_API_LEVELS=36,34
# System image selection: ATD default (built for CI, boots faster), google_apis escape hatch
SYSTEM_IMAGE_TYPE_DEFAULT=google_atd
SYSTEM_IMAGE_TYPE_LEGACY=google_apis
SYSTEM_IMAGE_ARCHITECTURE=x86_64
# AVD profile defaults
EMULATOR_RAM_MB=4096
EMULATOR_CORES=4
EMULATOR_DATA_PARTITION_SIZE=8G
EMULATOR_LCD_WIDTH=1080
EMULATOR_LCD_HEIGHT=2280
EMULATOR_LCD_DENSITY=440
# Maestro CLI baked into the -maestro variant
MAESTRO_VERSION=2.8.0
