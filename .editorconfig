root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.yaml]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

# shfmt reads this: keep `case` labels indented one level, matching how the
# shell scripts here are already written.
[{*.sh,emulator-tools,commit-msg}]
switch_case_indent = true
